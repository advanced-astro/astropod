---
import BaseLayout from './BaseLayout.astro'
import HeaderCard from '../components/headerCard/HeaderCard.astro'
import astropodConfig from '../../.astropod/astropod.config.json'

const { title, explicit, cover, description } = Astro.props
---

<BaseLayout title={`${title} - ${astropodConfig.name}`} {description} image={cover}>
  <HeaderCard {title} subtitle={astropodConfig.name} {cover} {explicit} />

  <main class="md:flex md:justify-center">
    <article class="card prose min-w-full prose-img:mx-auto bg-base-100 shadow-md p-8 mt-12">
      <slot />
    </article>
  </main>
</BaseLayout>
